{
  "name": "seo-audit-studio",
  "version": "1.0.0",
  "private": true,
  "description": "White-label, multilingual PDF SEO audit reports",
  "type": "module",
  "bin": {
    "seo-report": "./src/generate.ts"
  },
  "scripts": {
    "report": "node src/generate.ts",
    "report:all": "node src/generate.ts --all-langs",
    "studio": "npm run studio:build --silent && node studio/server.ts",
    "studio:dev": "node studio/dev.ts",
    "studio:build": "vite build --config studio/client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p studio/client/tsconfig.json",
    "doctor": "node scripts/doctor.ts",
    "check-social": "node scripts/check-social.ts",
    "setup": "node scripts/setup.ts"
  },
  "config": {
    "claudeSeoVersion": "2.4.2"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.10.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
